# Copie este arquivo para .env e preencha os valores. NUNCA versione o .env real.
#   copy .env.example .env   (Windows)

# --- IA (redação do dossiê) ---
# Provedor: "openai" (padrao) ou "anthropic". Só a redação do dossiê usa IA.
LLM_PROVIDER=openai
# Chave da OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo (opcional; tem padrão no código)
OPENAI_MODEL=gpt-5.6-terra
# Alternativa Anthropic (só se LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Dados públicos ---
# Chave gratuita do Portal da Transparência (opcional, recomendado):
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Sem ela o sistema funciona e marca sanções/repasses/convênios como pendentes.
TRANSPARENCIA_API_KEY=

# --- Acesso ao app (login HTTP Basic) ---
# Se APP_SENHA ficar vazia, não há login - só aceitável rodando em 127.0.0.1.
# Em qualquer acesso em rede/produção, defina uma senha.
APP_SENHA=
APP_USUARIOS=licitacoes

# --- Armazenamento (avançado) ---
# Local usa SQLite automaticamente. No AWS Lambda usa DynamoDB (detectado sozinho).
# Para testar o backend DynamoDB localmente, defina USAR_DYNAMO=1 (exige credenciais AWS).
# USAR_DYNAMO=
# DYNAMO_TABELA=analise-credito
